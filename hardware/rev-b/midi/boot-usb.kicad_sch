  (text "Place D301 at J301 and R307/R308 at the MCU. Impedance target: 90 ohm differential." (exclude_from_sim no) (at 20.32 82.55 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "d917e253-aca7-538c-9b32-3ff996458734"))
