  (text "Processor and MIDI connections" (exclude_from_sim no) (at 20.32 25.4 0) (effects (font (size 2.54 2.54) (thickness 0.508) (bold yes)) (justify left bottom)) (uuid "ab802a2d-b8b0-5c31-8afd-94531d7bf22d"))
  (text "QFN-80. MIDI OUT A / IN are UART0. OUT B, C and D have individual PIO transmit pins." (exclude_from_sim no) (at 20.32 33.02 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "c3ba074c-5910-5cf8-be3f-d7711b3e5a46"))
  (text "GPIOs left open on this sheet are available for the remaining sequencer circuits." (exclude_from_sim no) (at 20.32 35.56 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "1c619611-2687-5294-b0cb-9b629a215be1"))
  (text "On-chip 1.1 V buck converter" (exclude_from_sim no) (at 220.98 43.18 0) (effects (font (size 2.54 2.54) (thickness 0.508) (bold yes)) (justify left bottom)) (uuid "1f3d0014-6291-5fac-8966-8e64181745c1"))
  (text "L301 marked terminal 1 to +1V1; terminal 2 to VREG_LX. C306/C307 use R4 wide lands." (exclude_from_sim no) (at 220.98 110.49 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "4b9a7f0a-0f48-5c46-baf9-8643933a193f"))
  (text "Follow the RP2350B Minimal R4 switching loop, ground return, vias and inductor orientation." (exclude_from_sim no) (at 220.98 113.03 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "f9f88a06-91a2-5bb2-93f6-cac334250382"))
  (text "Local supply bypass" (exclude_from_sim no) (at 220.98 132.08 0) (effects (font (size 2.54 2.54) (thickness 0.508) (bold yes)) (justify left bottom)) (uuid "34e1b07b-5f19-5721-aac2-7231f8ac1b4a"))
  (text "Place the bypass capacitors at their MCU supply pins." (exclude_from_sim no) (at 220.98 210.82 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "13ab1dbd-4e54-5746-94ff-62e9cb40d275"))
  (text "USB_OTP_VDD and QSPI_IOVDD share the nearby 100 nF part in the reference layout." (exclude_from_sim no) (at 220.98 213.36 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "03e9c38b-8c0b-5530-9209-816849fbd9b5"))
