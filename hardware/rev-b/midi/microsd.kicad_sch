  (text "DAT1 and DAT2 are pulled up. The detect switch closes when a card is fully inserted." (exclude_from_sim no) (at 20.32 93.98 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "5692ed9d-ae53-5e50-bd44-ae28740d5311"))
  (text "Use a dedicated PIO SPI bus on GP32–GP35. Place the clock series resistor near U301." (exclude_from_sim no) (at 20.32 96.52 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "01686367-48d0-5a45-93b6-36050418d0bc"))
