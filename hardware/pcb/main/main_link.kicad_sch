  (text "Cable to the panel board: J1101 on the main board" (exclude_from_sim no) (at 20.32 30.48 0) (effects (font (size 2.54 2.54) (thickness 0.508) (bold yes)) (justify left bottom)) (uuid "d4fa4482-5a85-59fb-a998-7b6e3a84ad8c"))
  (text "R1101-R1106: source terminations, placed next to U301 (Pico) on the board, not at J1101." (exclude_from_sim no) (at 20.32 38.1 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "58402dd2-d4c0-593a-b510-4f5f0fe28e5b"))
  (text "LED_DATA 100 R (800 kbit/s, U901 input on the panel), OLED SPI and control 33 R." (exclude_from_sim no) (at 20.32 40.64 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "9ca2fd95-7252-5225-bc66-031ab51f7fec"))
  (text "J1101: right-angle shrouded 2x13 IDC header (2.54 mm), keyed; 26-wire ribbon, ~100 mm, to J1201" (exclude_from_sim no) (at 20.32 119.38 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "1b640ac6-400b-5f7e-b554-df1162d98397"))
  (text "on the panel board, wire n = pin n. A ribbon crimped the wrong way round puts pin n on pin 27-n:" (exclude_from_sim no) (at 20.32 121.92 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "5062f0e3-3093-5519-8e80-a615ae5b35a9"))
  (text "+5V_LED then meets GND (U201 limits it) and +3V3 meets +3V3 (pins 13/14). Ring the cable" (exclude_from_sim no) (at 20.32 124.46 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "c3ec38f5-bbeb-584c-9b2c-300d0cb2f486"))
  (text "pin 1 to pin 1 before the first power-up. Current: +5V_LED <= 306 mA on two contacts, the LED" (exclude_from_sim no) (at 20.32 127 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "d57d2100-16ae-5e90-b7b8-b990dec1504a"))
  (text "return on seven GND contacts; bring it to the Pico's GND, away from the DACs (sheet 5)." (exclude_from_sim no) (at 20.32 129.54 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "61de7600-ba0b-54d2-9933-0dc063fe2ca8"))
  (text "LED_DATA, OLED_SCK and both I2C lines sit between GND wires; +3V3 next to GND." (exclude_from_sim no) (at 20.32 132.08 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "5f4a65d2-690b-5b8b-9cf2-96b929c4ac3c"))
