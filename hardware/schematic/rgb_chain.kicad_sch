  (text "RGB lights: 82 x SK6812MINI-E in one chain, data from GPIO 27 (PIO), 5 V from +5V_LED" (exclude_from_sim no) (at 20.32 30.48 0) (effects (font (size 2.54 2.54) (thickness 0.508) (bold yes)) (justify left bottom)) (uuid "4a31511c-f81c-5c7c-b9b9-d3caa3107a7d"))
  (text "Chain order = firmware logical index + 1: D9nn is LED_PAD/SCENE/MUTE index nn-1 (LED_PAD(track,row) = row*8 + track," (exclude_from_sim no) (at 20.32 36.83 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "f3925813-5153-50fe-aca4-5c1f718e4963"))
  (text "LED_SCENE(row) = 64 + row, LED_MUTE(track) = 72 + track, LED_PLAY = 80, LED_BEAT = 81), so chain_order[] stays the identity." (exclude_from_sim no) (at 20.32 39.37 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "b9019ffd-f4ec-5814-9c5f-3040b8955e3b"))
  (text "Every D9nn has its own C9nn 100 nF X7R 0603 at its VDD pin. Route +5V_LED and GND as wide traces (a bus) along each row, not through" (exclude_from_sim no) (at 20.32 41.91 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "f1767430-642b-57f6-b9ca-fd3ea4561bbd"))
  (text "the LEDs. SK6812MINI-E: about 1 mA idle, 12 mA per channel nominal (20 mA until measured); firmware caps the chain at 200 mA." (exclude_from_sim no) (at 20.32 44.45 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "8a376e58-14c5-5540-8c2c-8f70b0d0f75f"))
  (text "U901 74AHCT1G125 on +5V_LED: TTL input takes the" (exclude_from_sim no) (at 20.32 114.3 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "f9c5f43b-1017-5a47-96ed-281e52668b3d"))
  (text "3.3 V GPIO, output swings to the LEDs' own 5 V" (exclude_from_sim no) (at 20.32 116.84 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "633be95f-e443-562d-87df-f418d1ff4811"))
  (text "(SK6812 needs VIH 0.7 x VDD = 3.5 V). OE tied low." (exclude_from_sim no) (at 20.32 119.38 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "4946744d-7b05-576e-bc54-e59e8076939a"))
  (text "R901 holds the buffer input low until the PIO runs," (exclude_from_sim no) (at 20.32 121.92 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "2e6ec010-bea8-5870-bda8-c0c6f6442261"))
  (text "R903 holds the first DIN low while U901 is still" (exclude_from_sim no) (at 20.32 124.46 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "87ca7974-3ac1-5d14-8f6a-53562f5cc385"))
  (text "unpowered. R902 390 R at the first LED damps the line." (exclude_from_sim no) (at 20.32 127 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "e4e4a204-ecf7-5618-943d-fdd515da7ca4"))
  (text "C984 470 uF 10 V low-ESR: bulk at the chain input" (exclude_from_sim no) (at 20.32 129.54 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "5592ccde-47a4-53dc-9679-d43f6ecc36ea"))
  (text "for the PWM current peaks; final value from a scope" (exclude_from_sim no) (at 20.32 132.08 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "ea684082-1242-5888-8684-b54edb0d48e9"))
  (text "check of +5V_LED (keep >= 4.5 V for U901)." (exclude_from_sim no) (at 20.32 134.62 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "627a661f-014f-5cd4-96ef-6fa24381b492"))
  (text "end of chain" (exclude_from_sim no) (at 142.24 328.93 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "4e12ae6a-57a3-5a02-b27d-ced9b3d5bed6"))
