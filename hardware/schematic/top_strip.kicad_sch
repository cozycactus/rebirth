  (text "OLED: SSD1309 128x64 (2.42 in), 4-wire SPI0" (exclude_from_sim no) (at 20.32 33.02 0) (effects (font (size 2.54 2.54) (thickness 0.508) (bold yes)) (justify left bottom)) (uuid "8899908b-0d33-56df-a3a2-03a8ba587040"))
  (text "J601: 7-pin header to the OLED module" (exclude_from_sim no) (at 124.46 52.07 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "e3932406-c544-5081-b5f6-96c81776ef68"))
  (text "(pin order GND VCC SCK SDA RES DC CS as" (exclude_from_sim no) (at 124.46 54.61 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "be3d01b3-183f-5bf6-a9d0-ac514d6b2791"))
  (text "printed on the common 2.42 in modules;" (exclude_from_sim no) (at 124.46 57.15 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "ecc1b0e5-0c5a-5198-a1f8-68f2a588562b"))
  (text "check the module before wiring)." (exclude_from_sim no) (at 124.46 59.69 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "6f26aab7-11be-5e42-9489-8b5096cd0eae"))
  (text "The module makes its panel voltage itself;" (exclude_from_sim no) (at 124.46 62.23 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "1eb63c30-2b72-5d9d-ab74-d243e794e29b"))
  (text "~25 mA from +3V3." (exclude_from_sim no) (at 124.46 64.77 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "29cd17c8-2da3-5d0b-ad2c-0963f0597a27"))
  (text "PLAY" (exclude_from_sim no) (at 190.5 33.02 0) (effects (font (size 2.54 2.54) (thickness 0.508) (bold yes)) (justify left bottom)) (uuid "b07dba96-4a79-51a2-8147-11284e966212"))
  (text "Pressed = low. GPIO 28 uses its internal pull-up," (exclude_from_sim no) (at 190.5 63.5 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "772dea34-b854-50e1-8671-074b0610f37e"))
  (text "20 ms firmware debounce. Its RGB light is D981" (exclude_from_sim no) (at 190.5 66.04 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "a22981a2-f705-5650-b86b-4e632748b036"))
  (text "in the chain (sheet 9), BEAT is D982." (exclude_from_sim no) (at 190.5 68.58 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "64849df8-1496-56aa-89ab-6aaf2258845b"))
  (text "Encoders: TRACK (enc 1) and VALUE (enc 2)" (exclude_from_sim no) (at 20.32 96.52 0) (effects (font (size 2.54 2.54) (thickness 0.508) (bold yes)) (justify left bottom)) (uuid "d13b6e08-71c4-5cf8-8cd1-1644463fcd0c"))
  (text "A/B contacts close to GND. R pull-up 10 k + R 10 k + C 10 nF per contact: the encoder maker's filter (tau 0.1 ms)." (exclude_from_sim no) (at 20.32 102.87 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "0979daec-747d-5d0d-a0f7-71b680d9cc2d"))
  (text "The GPIOs also enable their internal pull-ups. Push switch = low when pressed, firmware debounce 20 ms." (exclude_from_sim no) (at 20.32 105.41 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "b5662c7f-a54d-50cf-a632-0806bfefd4da"))
