  (text "ReBirth RP2040 sequencer with session-style live panel: whole system" (exclude_from_sim no) (at 20.32 22.86 0) (effects (font (size 2.54 2.54) (thickness 0.508) (bold yes)) (justify left bottom)) (uuid "828ae8e6-2348-5c56-925e-b11412193971"))
  (text "Two boards: main board (sheets 2-5, 11) on the case floor at the rear wall, panel board (sheets 6-10, 12) under the" (exclude_from_sim no) (at 20.32 30.48 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "b8d07a2c-d4d1-5386-b6e9-b2cc6a70fdcb"))
  (text "top plate, joined by a 26-wire ribbon J1101-J1201 (sheets 11, 12). Sheet pins meet by their labels; rails are global." (exclude_from_sim no) (at 20.32 33.02 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "a43fe6e4-54ec-5f49-b1a7-ff42e369274c"))
