  (text "U504 74AHCT125 on VBUS: TTL-level inputs accept the 3.3 V GPIO (VIH 2.0 V)," (exclude_from_sim no) (at 180.34 193.04 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "8b3f7813-9cdd-5f6f-bacb-b4e6f254d774"))
  (text "outputs swing to VBUS, so a gate is (0, 5, 5.25) V. R531-R534 hold the" (exclude_from_sim no) (at 180.34 195.58 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "ac9b8726-52d5-588b-bdc6-ebe9168a15e6"))
