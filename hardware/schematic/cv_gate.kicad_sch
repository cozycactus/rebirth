  (text "with the device unplugged. R541-R544 (1 k) limit a short to GND to ~5 mA;" (exclude_from_sim no) (at 180.34 200.66 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "ceca32ec-cd81-5a7c-b79e-161ac9ef005b"))
