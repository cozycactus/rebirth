  (text "U504 74AHCT125 on VBUS: TTL-level inputs accept the 3.3 V GPIO (VIH 2.0 V)," (exclude_from_sim no) (at 172.72 193.04 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "ea91d945-9d43-57e0-bbb9-c61f44711295"))
  (text "outputs swing to VBUS, so a gate is (0, 5, 5.25) V. R531-R534 hold the" (exclude_from_sim no) (at 172.72 195.58 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "0b5d476f-0a30-515b-9316-c71f059f864e"))
  (text "inputs low until the firmware drives GPIO 14-17. R541-R544 (1 k) protect" (exclude_from_sim no) (at 172.72 198.12 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "6b0a66be-29cc-5cc1-a9de-64dcc90bf17c"))
  (text "the outputs against shorts and patching into another output." (exclude_from_sim no) (at 172.72 200.66 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "64bd735f-a9b6-5d51-af30-b605e00bfd4b"))
