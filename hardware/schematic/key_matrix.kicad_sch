  (text "COL9" (exclude_from_sim no) (at 367.03 46.99 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "aac23197-9fac-5e64-afe1-5dee8833aae6"))
  (text "Scan (TCA8418 datasheet 8.4.2): columns are driven low one at a time, rows are inputs with pull-ups. Each key is" (exclude_from_sim no) (at 111.76 243.84 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "ee7d17da-b58f-5ab5-86a4-f5aaaa521819"))
  (text "row -> switch -> diode anode -> cathode -> column, so a held key can never feed a row back through another column: no ghost presses." (exclude_from_sim no) (at 111.76 246.38 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "a3fe6634-0668-5a3f-8912-60b167210472"))
  (text "Key event code k = 10 x row + column + 1 (1..80) = the last two digits of SW8kk and D8kk. Firmware table (row, col):" (exclude_from_sim no) (at 111.76 248.92 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "65d3bdc3-cad3-54bb-b4e1-928eebacb6eb"))
  (text "col 0-7 = pad (track col+1, slot row+1), col 8 = SCENE row+1, col 9 = MUTE track row+1. Chip debounce off, firmware 5-10 ms." (exclude_from_sim no) (at 111.76 251.46 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "fd9337fc-1e78-5bd4-9f77-eb28e2869015"))
  (text "Keys: MX-type switches under the pads (assumed; any momentary switch works). Diodes: 1N4148W. INT not used (polled), left open." (exclude_from_sim no) (at 111.76 254 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "2632159b-f2d4-5818-a8a0-439e5539add5"))
  (hierarchical_label "I2C_SCL" (shape input) (at 40.64 205.74 180) (effects (font (size 1.27 1.27)) (justify right)) (uuid "b25a9c30-4961-59f8-9688-880893f69cfe"))
  (hierarchical_label "I2C_SDA" (shape bidirectional) (at 40.64 208.28 180) (effects (font (size 1.27 1.27)) (justify right)) (uuid "aca26299-b493-547a-9614-4d8dce0d707c"))
