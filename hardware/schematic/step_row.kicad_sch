  (text "Firmware (unchanged hardware): U701 all 16 pins inputs with internal pull-ups and inverted polarity, read" (exclude_from_sim no) (at 20.32 180.34 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "cd2a543c-5471-55d0-a721-135d2e647f5d"))
  (text "as one 16-bit word, bit n = STEP n+1 (GPA0-7 = steps 1-8, GPB0-7 = steps 9-16). U701 INTA/INTB unused (polled)." (exclude_from_sim no) (at 20.32 182.88 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "e69f671e-2bb8-5a52-aaee-8cdcec9a608d"))
  (text "SW701-SW716: 6x6 mm tactile, pressed = low." (exclude_from_sim no) (at 20.32 185.42 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "1e5cdce6-1167-5eeb-9a04-ecf33a91f7ab"))
  (text "WARNING: the current MCP23017 datasheet (DS20001952 rev. D and later) makes GPA7 and GPB7 output-only." (exclude_from_sim no) (at 20.32 190.5 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "70027ed4-1f00-5f2e-b0f5-8f754dcb7c05"))
  (text "Steps 8 and 16 sit on those pins as the firmware expects; they may misread on new chips. See README." (exclude_from_sim no) (at 20.32 193.04 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "cec11403-52f6-55e4-bffd-e358c060980e"))
  (text "U702: all 16 pins outputs, bit n high = STEP n+1 lit (GPA0-7 = 1-8, GPB0-7 = 9-16)." (exclude_from_sim no) (at 215.9 180.34 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "f96aafe6-b364-52b7-ad78-b0e38fbd8d84"))
  (text "D701-D716: red 3 mm LEDs, 470 R: about 3 mA each from 3.3 V, 48 mA with all lit." (exclude_from_sim no) (at 215.9 182.88 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "43632152-1188-5d5d-8f46-8e3876824e5c"))
  (text "GPA7/GPB7 as outputs are fine." (exclude_from_sim no) (at 215.9 185.42 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid "613dfdc3-9cb6-59a6-8856-f95b62142b07"))
