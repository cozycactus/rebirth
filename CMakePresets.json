{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "firmware-debug",
      "displayName": "Firmware Debug (RP2040)",
      "description": "Cross-compile RP2040 firmware with Pico SDK",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/firmware-debug",
      "environment": {
        "PICO_SDK_PATH": "$penv{HOME}/.pico-sdk/sdk/2.2.0"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "firmware-release",
      "displayName": "Firmware Release (RP2040)",
      "description": "Cross-compile optimized RP2040 firmware",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/firmware-release",
      "environment": {
        "PICO_SDK_PATH": "$penv{HOME}/.pico-sdk/sdk/2.2.0"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "pico2-release",
      "inherits": "firmware-release",
      "displayName": "Firmware Release (Pico 2, RP2350 Arm)",
      "description": "Cross-compile optimized firmware for the Pico 2 module",
      "binaryDir": "${sourceDir}/build/pico2-release",
      "cacheVariables": {
        "PICO_BOARD": "pico2"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "firmware-debug",
      "configurePreset": "firmware-debug"
    },
    {
      "name": "firmware-release",
      "configurePreset": "firmware-release"
    },
    {
      "name": "pico2-release",
      "configurePreset": "pico2-release"
    }
  ],
  "testPresets": []
}
