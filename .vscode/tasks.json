{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "configure: firmware-debug",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--preset",
        "firmware-debug"
      ],
      "group": "build"
    },
    {
      "label": "build: firmware-debug",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--build",
        "--preset",
        "firmware-debug"
      ],
      "group": "build",
      "dependsOn": "configure: firmware-debug",
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "configure: host-tests-debug",
      "type": "shell",
      "command": "cmake",
      "args": [
        "-S",
        "test",
        "--preset",
        "host-tests-debug"
      ],
      "group": "test"
    },
    {
      "label": "build: host-tests-debug",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--build",
        "test/build/host-debug"
      ],
      "group": "test",
      "dependsOn": "configure: host-tests-debug",
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "run: host-tests-debug",
      "type": "shell",
      "command": "ctest",
      "args": [
        "--test-dir",
        "test/build/host-debug",
        "--output-on-failure"
      ],
      "group": "test",
      "dependsOn": "build: host-tests-debug",
      "problemMatcher": []
    }
  ]
}
